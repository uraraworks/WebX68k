{
  "name": "webx68k-mcp",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "MCP server that operates the WebX68k (X68000 emulator) running in a browser via a WebSocket bridge",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.mjs",
    "bundle": "esbuild server.mjs --bundle --platform=node --format=esm --target=node18 --external:bufferutil --external:utf-8-validate --banner:js=\"import{createRequire as __webx68kCreateRequire}from'node:module';const require=__webx68kCreateRequire(import.meta.url);\" --outfile=dist/webx68k-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "ws": "latest",
    "zod": "^3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
